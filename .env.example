# Environnement local
NODE_ENV=development

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/heig_odyssey?schema=public"

# Cache et événements Redis
REDIS_URL="redis://localhost:6379"

# Authentification Better Auth
# Génération recommandée : openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-secret-key-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Envoi des e-mails de vérification avec Resend
RESEND_API_KEY="re_replace-with-your-api-key"
RESEND_FROM_EMAIL="HEIG Odyssey <noreply@heig-odyssey.online>"
