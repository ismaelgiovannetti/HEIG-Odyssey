datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. Better Auth Models (Standard Schema)
// ----------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?
  pokemon       UserPokemon[]
  campaigns     CampaignProgress[]
  battles       BattleRecord[]
  gachaPulls    GachaPull[]
  questProgress UserQuestProgress[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ----------------------------------------------------
// 2. User Profile & Economy
// ----------------------------------------------------

model UserProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokedollars            Int       @default(0)
  hasCompletedOnboarding Boolean   @default(false)
  onboardingCompletedAt  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("user_profile")
}

// ----------------------------------------------------
// 3. Pokemon Collection & Active Team (1-6 slots)
// ----------------------------------------------------

model UserPokemon {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciesId    String   // ex: "turtwig", "chimchar", "piplup"
  nickname     String?
  level        Int      @default(5)
  experience   Int      @default(0)
  currentHp    Int
  maxHp        Int
  ivs          Json     // { hp: number, atk: number, def: number, spa: number, spd: number, spe: number }
  evs          Json     // { hp: number, atk: number, def: number, spa: number, spd: number, spe: number }
  moves        Json     // Array of 1-4 moves: [{ id: string, name: string, type: string, power: number, pp: number, maxPp: number }]
  ability      String?
  nature       String?
  gender       String?  @default("GENDERLESS") // M, F, GENDERLESS
  isShiny      Boolean  @default(false)
  teamPosition Int?     // 1 to 6 if in active team, null if in collection/PC
  caughtAt     DateTime @default(now())

  @@index([userId, teamPosition])
  @@map("user_pokemon")
}

// ----------------------------------------------------
// 4. Campaign Progression
// ----------------------------------------------------

model CampaignProgress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldId        String    // ex: "bachelor-1"
  stageId        String    // ex: "bachelor-1-stage-1"
  isCompleted    Boolean   @default(false)
  firstClearedAt DateTime?
  unlockedAt     DateTime  @default(now())

  @@unique([userId, stageId])
  @@index([userId, worldId])
  @@map("campaign_progress")
}

// ----------------------------------------------------
// 5. Battles & Idempotent Rewards
// ----------------------------------------------------

enum BattleType {
  CAMPAIGN
  TRAINING
}

enum BattleResult {
  IN_PROGRESS
  VICTORY
  DEFEAT
  ESCAPED
}

model BattleRecord {
  id                   String       @id @default(cuid())
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  battleType           BattleType
  opponentId           String       // ex: "trainer-jean" or "training-normal-01"
  opponentTeamSnapshot Json
  playerTeamSnapshot   Json
  result               BattleResult @default(IN_PROGRESS)
  turnsCount           Int          @default(0)
  rewardsClaimed       Boolean      @default(false)
  xpGained             Int          @default(0)
  moneyGained          Int          @default(0)
  idempotencyKey       String       @unique
  createdAt            DateTime     @default(now())
  completedAt          DateTime?

  @@index([userId, createdAt])
  @@map("battle_record")
}

// ----------------------------------------------------
// 6. Gacha System (Banners & Pulls)
// ----------------------------------------------------

model GachaBanner {
  id              String      @id @default(cuid())
  name            String
  description     String
  costPokedollars Int         @default(100)
  rates           Json        // { common: 0.70, rare: 0.25, epic: 0.05, shinyMultiplier: 0.01 }
  poolSpecies     Json        // Array of species keys
  isActive        Boolean     @default(true)
  startDate       DateTime    @default(now())
  endDate         DateTime?
  pulls           GachaPull[]

  @@map("gacha_banner")
}

model GachaPull {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannerId       String
  banner         GachaBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  speciesId      String
  isShiny        Boolean     @default(false)
  costPaid       Int
  idempotencyKey String      @unique
  pulledAt       DateTime    @default(now())

  @@index([userId, pulledAt])
  @@map("gacha_pull")
}

// ----------------------------------------------------
// 7. Quests System (Definitions, Rotations, User Progress)
// ----------------------------------------------------

enum QuestType {
  DAILY
  WEEKLY
}

model QuestDefinition {
  id                String          @id @default(cuid())
  title             String
  description       String
  type              QuestType
  targetType        String          // ex: "WIN_BATTLES", "TRAIN_POKEMON", "DEFEAT_TYPE_WATER"
  targetCount       Int
  rewardPokedollars Int             @default(50)
  rewardXp          Int             @default(100)
  rotations         QuestRotation[]

  @@map("quest_definition")
}

model QuestRotation {
  id             String              @id @default(cuid())
  periodKey      String              // ex: "2026-08-26" or "2026-W35"
  type           QuestType
  questId        String
  quest          QuestDefinition     @relation(fields: [questId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  userProgresses UserQuestProgress[]

  @@unique([periodKey, questId])
  @@map("quest_rotation")
}

model UserQuestProgress {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotationId    String
  rotation      QuestRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  currentCount  Int           @default(0)
  isCompleted   Boolean       @default(false)
  rewardClaimed Boolean       @default(false)
  claimedAt     DateTime?
  updatedAt     DateTime      @updatedAt

  @@unique([userId, rotationId])
  @@index([userId, isCompleted])
  @@map("user_quest_progress")
}
